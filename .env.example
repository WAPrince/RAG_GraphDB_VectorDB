ANTHROPIC_API_KEY=YOUR_VALUES
AWS_REGION=YOUR_VALUES
AWS_PROFILE=YOUR_VALUES

LANGFUSE_SECRET_KEY=YOUR_VALUES
LANGFUSE_PUBLIC_KEY=YOUR_VALUES
LANGFUSE_BASE_URL="http://localhost:3000"

#semantic search
MINILM_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
BAAI_MODEL_NAME="BAAI/bge-small-en-v1.5"

HARRIER_MODEL_NAME="microsoft/harrier-oss-v1-0.6b"
QWEN_MODEL_NAME="Qwen/Qwen3-Embedding-8B"

SEMANTIC_SEARCH_EMBEDDING_MODEL=${MINILM_MODEL_NAME}

#keyword search
BM25_MODEL_NAME="Qdrant/bm25"
SPLADE_MODEL_NAME="naver/splade-cocondenser-ensembledistil"

#hybrid search
BAAIM3_MODEL_NAME="BAAI/bge-m3"

#reranking
RERANKER_MODEL_NAME="BAAI/bge-reranker-v2-m3"